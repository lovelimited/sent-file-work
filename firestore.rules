rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'drive.limited@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isReviewer() {
      return isAuthenticated() && (getUserRole() == 'reviewer' || isAdmin());
    }

    function isActiveUser() {
      return isAuthenticated();
    }

    // Users Collection - Allow real-time sync across all devices
    match /users/{uid} {
      allow read, write: if true;
    }

    // Username Index
    match /usernameIndex/{username} {
      allow read, write: if true;
    }

    // Submissions
    match /submissions/{submissionId} {
      allow read, write: if true;

      // Nested Versions
      match /versions/{versionId} {
        allow read, write: if true;
      }
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Topics (หัวข้อเรื่องที่แอดมินสร้าง)
    match /topics/{topicId} {
      allow read, write: if true;
    }

    match /versions/{versionId} {
      allow read, write: if true;
    }

    // Submission Types and Rounds
    match /submissionTypes/{typeId} {
      allow read, write: if true;
    }

    match /submissionRounds/{roundId} {
      allow read, write: if true;
    }

    // Rubrics
    match /rubrics/{rubricId} {
      allow read, write: if true;
    }

    // Central Library
    match /libraryCategories/{catId} {
      allow read, write: if true;
    }

    match /libraryFiles/{fileId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    // System Settings
    match /systemSettings/{docId} {
      allow read, write: if true;
    }
  }
}
